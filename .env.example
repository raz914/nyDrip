# Copy to `.env.local` and fill in values (never commit real secrets).

# Netlify deploys: omit known non-secret public/config values from secrets scanning.
SECRETS_SCAN_OMIT_KEYS=GOOGLE_CALENDAR_ADMIN_CALENDAR_ID,GOOGLE_CALENDAR_TIME_ZONE,MAPS_PROVIDER,CONTACT_TO_EMAIL,CONTACT_FROM_EMAIL

# Firebase Admin (JSON string on one line, valid for JSON.parse — no space after `=`)
FIREBASE_SERVICE_ACCOUNT_KEY=

# Alternative split vars if not using FIREBASE_SERVICE_ACCOUNT_KEY:
# FIREBASE_ADMIN_PROJECT_ID=
# FIREBASE_PROJECT_ID=
# FIREBASE_ADMIN_CLIENT_EMAIL=
# FIREBASE_ADMIN_PRIVATE_KEY=
# FIREBASE_STORAGE_BUCKET=

# Maps / travel fee (server; NEXT_PUBLIC_* if exposed to client)
GOOGLE_MAPS_API_KEY=
NEXT_PUBLIC_GOOGLE_MAPS_API_KEY=
MAPS_PROVIDER=
NEXT_PUBLIC_MAPS_PROVIDER=

# Google Calendar (server) — see lib/googleCalendar.js
GOOGLE_CALENDAR_CLIENT_ID=
GOOGLE_CALENDAR_CLIENT_SECRET=
GOOGLE_CALENDAR_REFRESH_TOKEN=
GOOGLE_CALENDAR_ADMIN_CALENDAR_ID=
GOOGLE_CALENDAR_TIME_ZONE=

# Contact form email delivery (server)
SMTP_HOST=
SMTP_PORT=
SMTP_SECURE=
SMTP_USER=example@example.com
SMTP_PASS=
CONTACT_TO_EMAIL=
CONTACT_FROM_EMAIL=example@example.com
NEXT_PUBLIC_CONTACT_EMAIL=info@nydriplounge.com

# Stripe (server/client URL)
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Local development only: bypass Stripe checkout and simulate successful payment
DEV_BYPASS_STRIPE=false
